# Copy this file to .env and fill in the values. Never commit .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# True only on your own machine. Defaults to False when unset.
DJANGO_DEBUG=True

# Comma-separated host names the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (with scheme) allowed to submit forms, needed behind HTTPS proxies.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://edufin.example.com

# Production HTTPS settings. They default to ON when DJANGO_DEBUG is False.
# Set them to False only to try the production settings locally over plain HTTP.
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=False
# Set to True when a reverse proxy (nginx, Render, Railway…) terminates TLS and sends X-Forwarded-Proto.
# DJANGO_BEHIND_PROXY=False

# Optional
# DJANGO_DB_PATH=db.sqlite3
# DJANGO_TIME_ZONE=Africa/Kigali
# EDUFIN_CURRENCY=RWF
